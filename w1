#include <iostream>
using namespace std;

int main()
{
    int year;

    cout << "Enter a year: ";
    cin >> year;

    if (year % 400 == 0 || (year % 4 == 0 && year % 100 != 0))
    {
        cout << "Yes it is a leap year";
    }
    else
    {
        cout << "No it is not a leap year";
    }

    return 0;
}

