import java.util.*;

public class Main {
    // print the mean of 6 numbers
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int num1, num2, num3, num4, num5, num6;

        num1 = sc.nextInt();
        num2 = sc.nextInt();
        num3 = sc.nextInt();
        num4 = sc.nextInt();
        num5 = sc.nextInt();
        num6 = sc.nextInt();

        double mean = (num1 + num2 + num3 + num4 + num5 + num6) / 6.0;

        System.out.println(mean);
        sc.close();
    }
}
